{
  "name": "llm-zero-to-one",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "data": "tsx scripts/data.ts",
    "start": "node --env-file-if-exists=.env apps/api/dist/main.js",
    "build": "pnpm --filter @llm/web build && tsx scripts/build-api.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "content:check": "tsx scripts/validate-content.ts",
    "test": "vitest run",
    "test:e2e": "pnpm build && playwright test",
    "check": "pnpm content:check && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "experiment:setup": "node --env-file-if-exists=.env --import tsx scripts/setup-runner.ts",
    "experiment:verify": "node --env-file-if-exists=.env --import tsx scripts/verify-experiment.ts",
    "release:check": "tsx scripts/release-check.ts",
    "release:package": "tsx scripts/package-release.ts"
  },
  "devDependencies": {
    "@llm/contracts": "workspace:*",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.27.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.5.0",
    "prettier": "^3.7.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0",
    "vitest": "^4.0.0"
  }
}
